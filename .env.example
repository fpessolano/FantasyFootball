# Fantasy Football Manager Configuration
# Copy this file to .env and update with your values

# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./db/ffm.db

# API Keys (for future integrations)
# FOOTBALL_DATA_API_KEY=your_api_key_here
# OPENAI_API_KEY=your_api_key_here

# UI Settings
TERMINAL_THEME=auto  # auto, light, dark
DEFAULT_LANGUAGE=en

# Performance
CACHE_TTL=3600
MAX_WORKERS=4